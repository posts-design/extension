{
  "manifest_version": 3,
  "name": "posts.design new tab",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "A featured launch post from posts.design on every new tab.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "homepage_url": "https://posts.design/?utm_source=chrome-extension&utm_medium=referral"
}
